# ==============================================================================
# Raxo Email — Production Environment Configuration Template
# Target: Contabo VPS (Ubuntu 22.04 / 24.04 LTS), Domain: btctoons.com
# INSTRUCTIONS: Copy to .env.production on the VPS and populate strong credentials.
# NEVER commit real production credentials to Git or public repositories.
# ==============================================================================

# Node Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Database Configuration (PostgreSQL 16)
# Note: In docker-compose.prod.yml, postgres is reachable at host 'postgres'
POSTGRES_DB=raxo_production
POSTGRES_USER=raxo_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_64_CHAR_HEX_SECRET
DATABASE_URL=postgresql://raxo_user:CHANGE_ME_TO_STRONG_64_CHAR_HEX_SECRET@postgres:5432/raxo_production

# Storage Directory (Inside container; mapped to persistent volume attachment_storage)
STORAGE_DIR=/app/storage
FORMS_CONFIG_PATH=/app/config/forms.json

# IP Hashing Secret (Used to anonymize rate-limiting buckets; must be 32+ random hex bytes)
# Generate with: openssl rand -hex 32
IP_HASH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Production Postal SMTP Engine Configuration
# Proposed hostnames:
# - forms.btctoons.com: Public web gateway
# - mail.btctoons.com: Postal SMTP server
# - notify.btctoons.com: Sending domain (SPF/DKIM/DMARC)
# - bounces.btctoons.com: Bounce processing domain
SMTP_HOST=mail.btctoons.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls_required
SMTP_USERNAME=raxo_postal_sender
SMTP_PASSWORD=CHANGE_ME_TO_POSTAL_GENERATED_CREDENTIAL
SMTP_MAX_MESSAGE_BYTES=20971520
MESSAGE_ID_DOMAIN=notify.btctoons.com
OUTBOUND_ENABLED=true

# ClamAV Antivirus Daemon
# In docker-compose.prod.yml, clamav container runs on internal network
CLAMD_HOST=clamav
CLAMD_PORT=3310

# Security and Demo Settings
DEMO_MODE=false
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,127.0.0.1/32
