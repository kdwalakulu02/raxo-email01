# Copy to deploy/staging/.env.staging (git-ignored) and fill in. Never commit the filled-in file.
COMPOSE_PROJECT_NAME=raxo_combo
POSTGRES_DB=raxo_combo
POSTGRES_USER=raxo_combo
# generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# generate with: openssl rand -hex 32
IP_HASH_SECRET=
# Directory prepared by deploy/sentinel/fetch-sentinel.sh and deploy/staging/prepare-clamav-defs.sh
PRIVATE_DIR=/root/raxo-combo-private
